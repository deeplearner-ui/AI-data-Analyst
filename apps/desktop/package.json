{
  "name": "@aida/desktop",
  "version": "0.1.7",
  "description": "Local-first AI data analysis desktop assistant",
  "author": "AI Data Analyst",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:win": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "@aida/contracts": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.6.2",
    "plotly.js-dist-min": "^3.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/plotly.js": "^3.0.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "26.15.7",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.aida.desktop",
    "productName": "AI Data Analyst",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [{ "from": "../sidecar/dist/aida-sidecar", "to": "sidecar-runtime" }],
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "win": { "target": ["nsis"] }
  }
}
